{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "rootDir": "../",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "types": ["node"],
    "typeRoots": [
      "./node_modules/@types",
      "../node_modules/@types"
    ],
    "paths": {
      "*": ["node_modules/*", "./node_modules/*"]
    }
  },
  "include": [
    "src/**/*",
    "../auth/**/*",
    "../security/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../frontend"
  ]
}

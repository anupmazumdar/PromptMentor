# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL - Supabase / Neon connection string)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres?sslmode=require"

# JWT Secrets (MANDATORY: Server will fail at startup if not set; use 32+ character random strings)
JWT_ACCESS_SECRET="your_super_secret_access_key_min_32_characters_here"
JWT_REFRESH_SECRET="your_super_secret_refresh_key_min_32_characters_here"

# AI Layer: OpenRouter (Primary)
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_MODEL="meta-llama/llama-3.1-8b-instruct:free"

# Fallback AI (Optional - Groq free tier)
GROQ_API_KEY="your_groq_api_key_here"

# Security & CORS
FRONTEND_URL="http://localhost:5173"

# Render 24/7 Keep-Alive (Set this to your live Render backend URL)
RENDER_EXTERNAL_URL="https://promptmentor.onrender.com"
